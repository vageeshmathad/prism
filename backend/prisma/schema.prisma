// ============================================================
// PRISM - AI-Powered Software Engineering Evaluation Platform
// Prisma Schema — Production-Ready, Multi-Tenant
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  PLATFORM_ADMIN
  INSTITUTION_ADMIN
  FACULTY_COORDINATOR
  FACULTY_EVALUATOR
  PROJECT_GUIDE
  TEAM_LEAD
  STUDENT
  STAKEHOLDER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MetricStatus {
  PASSED
  WARNING
  FAILED
  UNAVAILABLE
  NOT_APPLICABLE
  PENDING
}

enum SecuritySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum QuizStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
}

enum FindingStatus {
  OPEN
  REVIEWING
  RESOLVED
  WONT_FIX
}

enum PhaseNumber {
  PHASE_1
  PHASE_2
  PHASE_3
}

enum NotificationType {
  EVALUATION_COMPLETE
  EVALUATION_FAILED
  QUIZ_ASSIGNED
  QUIZ_DUE_SOON
  QUIZ_COMPLETED
  APPEAL_SUBMITTED
  APPEAL_RESOLVED
  SCORE_OVERRIDDEN
  INTEGRITY_FLAG_RAISED
  SECURITY_FINDING
  PR_MERGED
  TEAM_MEMBER_ADDED
  REVIEW_REQUIRED
  SYSTEM_ANNOUNCEMENT
}

enum MetricType {
  CONTEXT
  SCORED
  FLAG
}

enum QuestionType {
  EXPLAIN
  FILL_CODE
  PREDICT_OUTPUT
  IDENTIFY_BUG
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED_ACCEPTED
  RESOLVED_REJECTED
  WITHDRAWN
}

enum IntegrityFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContributionType {
  CODE
  REVIEW
  DOCUMENTATION
  TESTING
  DESIGN
  DEVOPS
}

// ============================================================
// TENANT / INSTITUTION LAYER
// ============================================================

model Institution {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  code       String   @unique
  logoUrl    String?
  adminEmail String
  settings   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  departments         Department[]
  academicYears       AcademicYear[]
  users               User[]
  projects            Project[]
  teams               Team[]
  repositories        Repository[]
  evaluationRuns      EvaluationRun[]
  metricDefinitions   MetricDefinition[]
  quizzes             Quiz[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  roles               Role[]
  githubInstallations GithubInstallation[]
  integrityFlags      IntegrityFlag[]
  securityFindings    SecurityFinding[]
  appeals             Appeal[]
  rubricVersions      RubricVersion[]

  // GitHub integration back-relations
  githubAccounts        GitHubAccount[]
  uploadedProjects      UploadedProject[]
  repoIntegrations      RepositoryIntegration[]
  analysisRuns          AnalysisRun[]

  @@index([slug])
  @@index([isActive])
}

model Department {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  code          String
  headName      String?
  headEmail     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  projects    Project[]
  users       User[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model AcademicYear {
  id            String   @id @default(cuid())
  institutionId String
  label         String // e.g. "2024-25"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@unique([institutionId, label])
  @@index([institutionId, isCurrent])
}

// ============================================================
// IAM — USER / ROLE / PERMISSION
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(STUDENT)
  institutionId String
  departmentId  String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  avatarUrl     String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Role assignments (fine-grained)
  userRoles UserRoleAssignment[]

  // Team memberships
  teamMemberships TeamMember[]

  // Projects created by this user
  createdProjects Project[] @relation("ProjectCreator")

  // Quiz relations
  assignedQuizzes Quiz[]   @relation("QuizAssignee")
  answers         Answer[]

  // Review relations
  reviewedAnswers AnswerEvaluation[] @relation("AnswerReviewer")
  facultyReviews  FacultyReview[]    @relation("ReviewFaculty")
  scoreOverrides  ScoreOverride[]    @relation("OverrideFaculty")

  // Appeals
  submittedAppeals Appeal[] @relation("AppealSubmitter")
  resolvedAppeals  Appeal[] @relation("AppealResolver")

  // Notifications
  notifications Notification[]

  // Audit
  auditLogs AuditLog[]

  // GitHub integration
  githubAccounts        GitHubAccount[]
  repoContributions     RepositoryContributor[]
  uploadedProjects      UploadedProject[]

  @@index([institutionId])
  @@index([email])
  @@index([role])
  @@index([institutionId, role])
}

model Role {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  description   String?
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String // e.g. "evaluation", "quiz", "project"
  action      String // e.g. "create", "read", "update", "delete", "approve"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  grantedBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================
// PROJECT / TEAM LAYER
// ============================================================

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  objectives     String?
  technologies   String[]
  status         ProjectStatus @default(DRAFT)
  institutionId  String
  departmentId   String?
  academicYearId String?
  startDate      DateTime?
  endDate        DateTime?
  createdById    String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  teams          Team[]
  repositories   Repository[]
  evaluationRuns EvaluationRun[]
  rubricVersions RubricVersion[]
  repoIntegrations RepositoryIntegration[]
  uploadedProjects UploadedProject[]

  @@index([institutionId])
  @@index([status])
  @@index([institutionId, status])
  @@index([academicYearId])
}

model Team {
  id            String   @id @default(cuid())
  name          String
  projectId     String
  institutionId String
  githubTeamId  String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  members             TeamMember[]
  evaluationRuns      EvaluationRun[]
  quizzes             Quiz[]
  contributionRecords ContributionRecord[]
  integrityFlags      IntegrityFlag[]
  repoIntegrations    RepositoryIntegration[]
  uploadedProjects    UploadedProject[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([institutionId])
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  isLead    Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ============================================================
// GITHUB INTEGRATION LAYER
// ============================================================

model GithubInstallation {
  id             String   @id @default(cuid())
  institutionId  String
  installationId String   @unique
  accountLogin   String
  accountType    String // "Organization" | "User"
  appId          String
  targetId       String
  permissions    Json     @default("{}")
  events         String[]
  isActive       Boolean  @default(true)
  installedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@index([institutionId])
  @@index([installationId])
}

model Repository {
  id             String    @id @default(cuid())
  institutionId  String
  projectId      String?
  installationId String?
  githubRepoId   String    @unique
  fullName       String // "org/repo"
  defaultBranch  String    @default("main")
  language       String?
  languages      Json      @default("{}")
  isPrivate      Boolean   @default(true)
  cloneUrl       String?
  htmlUrl        String?
  webhookId      String?
  webhookSecret  String?
  lastSyncedAt   DateTime?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  institution  Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  installation GithubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  commits          Commit[]
  pullRequests     PullRequest[]
  evaluationRuns   EvaluationRun[]
  webhookEvents    WebhookEvent[]
  securityFindings SecurityFinding[]

  @@index([institutionId])
  @@index([projectId])
  @@index([fullName])
}

model WebhookEvent {
  id           String    @id @default(cuid())
  repositoryId String
  deliveryId   String    @unique
  eventType    String
  action       String?
  payload      Json
  processed    Boolean   @default(false)
  processedAt  DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([processed])
  @@index([eventType])
  @@index([createdAt])
}

model Commit {
  id           String   @id @default(cuid())
  repositoryId String
  sha          String
  message      String
  authorName   String
  authorEmail  String
  authoredAt   DateTime
  committedAt  DateTime
  additions    Int      @default(0)
  deletions    Int      @default(0)
  filesChanged Int      @default(0)
  parentShas   String[]
  verified     Boolean  @default(false)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  contributionRecords ContributionRecord[]

  @@unique([repositoryId, sha])
  @@index([repositoryId])
  @@index([authorEmail])
  @@index([authoredAt])
}

model PullRequest {
  id             String    @id @default(cuid())
  repositoryId   String
  githubPrNumber Int
  title          String
  description    String?
  state          String // "open" | "closed" | "merged"
  authorLogin    String
  authorEmail    String?
  headBranch     String
  baseBranch     String
  mergeCommitSha String?
  additions      Int       @default(0)
  deletions      Int       @default(0)
  changedFiles   Int       @default(0)
  isDraft        Boolean   @default(false)
  labels         String[]
  reviewers      String[]
  mergedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  repository       Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  changedFilesList ChangedFile[]
  evaluationRuns   EvaluationRun[]

  @@unique([repositoryId, githubPrNumber])
  @@index([repositoryId])
  @@index([state])
  @@index([authorLogin])
  @@index([mergedAt])
}

model ChangedFile {
  id            String   @id @default(cuid())
  pullRequestId String
  filename      String
  status        String // "added" | "modified" | "deleted" | "renamed"
  additions     Int      @default(0)
  deletions     Int      @default(0)
  patch         String?
  language      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([filename])
}

// ============================================================
// EVALUATION ENGINE
// ============================================================

model EvaluationRun {
  id                 String           @id @default(cuid())
  institutionId      String
  repositoryId       String
  projectId          String?
  teamId             String?
  pullRequestId      String?
  mergeCommitSha     String?
  evaluationKey      String           @unique // deterministic: "repoId:prNumber:phase"
  status             EvaluationStatus @default(PENDING)
  phase              PhaseNumber
  rubricVersionId    String?
  overallScore       Float?
  qualityScore       Float?
  contributionScore  Float?
  understandingScore Float?
  findings           Json             @default("[]")
  triggeredBy        String? // "webhook" | "manual" | "scheduled"
  errorMessage       String?
  durationMs         Int?
  metadata           Json             @default("{}")
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  repository    Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  pullRequest   PullRequest?   @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  rubricVersion RubricVersion? @relation(fields: [rubricVersionId], references: [id], onDelete: SetNull)

  metricResults       MetricResult[]
  contributionRecords ContributionRecord[]
  facultyReviews      FacultyReview[]
  scoreOverrides      ScoreOverride[]
  quizzes             Quiz[]
  integrityFlags      IntegrityFlag[]
  securityFindings    SecurityFinding[]
  analysisRuns        AnalysisRun[]

  @@index([institutionId])
  @@index([repositoryId])
  @@index([projectId])
  @@index([teamId])
  @@index([status])
  @@index([phase])
  @@index([evaluationKey])
  @@index([createdAt])
}

model MetricDefinition {
  id                   String           @id @default(cuid())
  institutionId        String? // null = global default
  metricId             String           @unique // e.g. "code_duplication"
  name                 String
  category             String // e.g. "code_quality", "security", "contribution"
  description          String?
  type                 MetricType
  calculationMethod    String?
  supportedLanguages   String[]
  applicablePhase      PhaseNumber[]
  analyzer             String? // e.g. "sonarqube", "semgrep", "custom"
  threshold            Json             @default("{}")
  severity             SecuritySeverity @default(INFO)
  weight               Float            @default(1.0)
  normalizationMethod  String?
  evidenceRequirements Json             @default("[]")
  isAvailable          Boolean          @default(true)
  version              String           @default("1.0.0")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  institution   Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  metricResults MetricResult[]

  @@index([category])
  @@index([isAvailable])
  @@index([institutionId])
}

model MetricResult {
  id                 String       @id @default(cuid())
  evaluationRunId    String
  metricDefinitionId String
  status             MetricStatus @default(PENDING)
  rawValue           Float?
  normalizedScore    Float? // 0–100
  weight             Float        @default(1.0)
  weightedScore      Float?
  evidence           Json         @default("[]")
  details            Json         @default("{}")
  errorMessage       String?
  computedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  evaluationRun    EvaluationRun    @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@unique([evaluationRunId, metricDefinitionId])
  @@index([evaluationRunId])
  @@index([metricDefinitionId])
  @@index([status])
}

// ============================================================
// RUBRIC / SCORING CONFIGURATION
// ============================================================

model RubricVersion {
  id            String    @id @default(cuid())
  institutionId String
  projectId     String?
  version       String // semver e.g. "2.1.0"
  label         String
  config        Json // full rubric JSON blob
  isActive      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  phaseWeights    PhaseWeight[]
  scoreComponents ScoreComponent[]
  evaluationRuns  EvaluationRun[]

  @@unique([institutionId, version])
  @@index([institutionId])
  @@index([isActive])
}

model PhaseWeight {
  id              String      @id @default(cuid())
  rubricVersionId String
  phase           PhaseNumber
  weight          Float // sum of all phases = 1.0
  label           String?
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  rubricVersion RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@unique([rubricVersionId, phase])
  @@index([rubricVersionId])
}

model ScoreComponent {
  id               String   @id @default(cuid())
  rubricVersionId  String
  name             String // e.g. "Code Quality", "Contribution", "Viva Understanding"
  key              String // e.g. "code_quality"
  weight           Float // fraction of total phase score
  description      String?
  metricIds        String[] // references MetricDefinition.metricId
  calculationLogic Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rubricVersion RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@unique([rubricVersionId, key])
  @@index([rubricVersionId])
}

// ============================================================
// CONTRIBUTION TRACKING
// ============================================================

model ContributionRecord {
  id               String           @id @default(cuid())
  evaluationRunId  String
  teamId           String
  commitId         String?
  authorEmail      String
  authorName       String
  contributionType ContributionType @default(CODE)
  linesAdded       Int              @default(0)
  linesDeleted     Int              @default(0)
  filesModified    String[]
  complexity       Float? // cyclomatic complexity delta
  reviewComments   Int              @default(0)
  evidence         Json             @default("{}")
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  commit        Commit?       @relation(fields: [commitId], references: [id], onDelete: SetNull)

  contributionScores ContributionScore[]

  @@index([evaluationRunId])
  @@index([teamId])
  @@index([authorEmail])
}

model ContributionScore {
  id                   String   @id @default(cuid())
  contributionRecordId String
  dimension            String // "volume", "quality", "complexity", "review"
  rawScore             Float
  normalizedScore      Float // 0–100
  weight               Float    @default(1.0)
  weightedScore        Float
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contributionRecord ContributionRecord @relation(fields: [contributionRecordId], references: [id], onDelete: Cascade)

  @@unique([contributionRecordId, dimension])
  @@index([contributionRecordId])
}

// ============================================================
// QUIZ / VIVA UNDERSTANDING LAYER
// ============================================================

model Quiz {
  id               String      @id @default(cuid())
  institutionId    String
  evaluationRunId  String?
  teamId           String?
  assigneeId       String? // individual student
  status           QuizStatus  @default(DRAFT)
  phase            PhaseNumber
  title            String
  instructions     String?
  timeLimitMinutes Int?
  scheduledAt      DateTime?
  expiresAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  totalPoints      Float       @default(0)
  awardedPoints    Float?
  metadata         Json        @default("{}")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  evaluationRun EvaluationRun? @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("QuizAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  questions Question[]
  answers   Answer[]

  @@index([institutionId])
  @@index([evaluationRunId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
}

model Question {
  id              String       @id @default(cuid())
  quizId          String
  questionType    QuestionType
  text            String
  codeSnippet     String?
  expectedAnswer  String?
  concepts        String[]
  difficulty      Int          @default(3) // 1–5
  points          Float        @default(10)
  sourceFile      String? // filename from repo
  lineRange       Json? // { start: Int, end: Int }
  modelIdentifier String? // which AI model generated this
  promptVersion   String?
  orderIndex      Int          @default(0)
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId])
  @@index([questionType])
  @@index([difficulty])
}

model Answer {
  id               String   @id @default(cuid())
  questionId       String
  quizId           String
  studentId        String
  textAnswer       String?
  codeAnswer       String?
  attachments      Json     @default("[]")
  submittedAt      DateTime @default(now())
  timeSpentSeconds Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  evaluation AnswerEvaluation?

  @@unique([questionId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@index([questionId])
}

model AnswerEvaluation {
  id                 String    @id @default(cuid())
  answerId           String    @unique
  awardedPoints      Float
  maxPoints          Float
  missingConcepts    String[]
  presentConcepts    String[]
  explanation        String?
  confidence         Float? // 0.0–1.0 AI confidence
  needsFacultyReview Boolean   @default(false)
  reviewedById       String?
  reviewedAt         DateTime?
  overrideReason     String?
  aiModel            String?
  promptVersion      String?
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  answer     Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("AnswerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([answerId])
  @@index([needsFacultyReview])
  @@index([reviewedById])
}

// ============================================================
// SECURITY / INTEGRITY
// ============================================================

model SecurityFinding {
  id              String           @id @default(cuid())
  institutionId   String
  repositoryId    String
  evaluationRunId String?
  ruleId          String
  ruleName        String
  category        String // "injection", "xss", "auth", "crypto", etc.
  severity        SecuritySeverity
  status          FindingStatus    @default(OPEN)
  filePath        String?
  startLine       Int?
  endLine         Int?
  snippet         String?
  message         String
  remediation     String?
  cweId           String? // CWE identifier
  cvssScore       Float?
  evidence        Json             @default("{}")
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  repository    Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  evaluationRun EvaluationRun? @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([repositoryId])
  @@index([severity])
  @@index([status])
  @@index([category])
}

model IntegrityFlag {
  id              String                @id @default(cuid())
  institutionId   String
  teamId          String?
  evaluationRunId String?
  flagType        String // "plagiarism", "ai_generated", "commit_stuffing", etc.
  severity        IntegrityFlagSeverity @default(MEDIUM)
  description     String
  evidence        Json                  @default("{}")
  affectedFiles   String[]
  affectedAuthors String[]
  similarityScore Float? // 0.0–1.0 for plagiarism
  status          FindingStatus         @default(OPEN)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  evaluationRun EvaluationRun? @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([teamId])
  @@index([severity])
  @@index([status])
  @@index([flagType])
}

// ============================================================
// FACULTY REVIEW / OVERRIDE / APPEAL
// ============================================================

model FacultyReview {
  id               String   @id @default(cuid())
  evaluationRunId  String
  facultyId        String
  reviewType       String // "evaluation_review", "quiz_review", "integrity_review"
  comments         String?
  recommendedScore Float?
  approved         Boolean?
  reviewedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  faculty       User          @relation("ReviewFaculty", fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([evaluationRunId])
  @@index([facultyId])
}

model ScoreOverride {
  id              String    @id @default(cuid())
  evaluationRunId String
  facultyId       String
  component       String // "overall", "quality", "contribution", "understanding"
  previousScore   Float
  newScore        Float
  reason          String
  evidence        Json      @default("{}")
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  faculty       User          @relation("OverrideFaculty", fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([evaluationRunId])
  @@index([facultyId])
}

model Appeal {
  id              String       @id @default(cuid())
  institutionId   String
  evaluationRunId String?
  submittedById   String
  resolvedById    String?
  status          AppealStatus @default(SUBMITTED)
  subject         String
  description     String
  evidence        Json         @default("[]")
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  submittedBy User        @relation("AppealSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  resolvedBy  User?       @relation("AppealResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([status])
  @@index([submittedById])
}

// ============================================================
// NOTIFICATIONS / AUDIT
// ============================================================

model Notification {
  id            String           @id @default(cuid())
  institutionId String
  userId        String
  type          NotificationType
  title         String
  message       String
  link          String?
  metadata      Json             @default("{}")
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([institutionId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  userId        String?
  action        String // e.g. "evaluation.created", "score.overridden"
  resource      String // e.g. "EvaluationRun"
  resourceId    String?
  before        Json? // snapshot before change
  after         Json? // snapshot after change
  ipAddress     String?
  userAgent     String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// GITHUB INTEGRATION EXTENSION
// ============================================================

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum SyncStatus {
  PENDING
  SYNCING
  COMPLETED
  FAILED
}

enum UploadStatus {
  UPLOADED
  VALIDATING
  VALID
  INVALID
  ANALYSING
  COMPLETED
  FAILED
}

enum GitHubAccountStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// GitHub OAuth account linked to a PRISM user
model GitHubAccount {
  id                String              @id @default(cuid())
  userId            String
  institutionId     String
  githubUserId      String              @unique // numeric GitHub user ID
  githubLogin       String              // GitHub username
  githubName        String?
  githubEmail       String?
  githubAvatarUrl   String?
  githubProfileUrl  String?
  // tokens stored encrypted — never plain text
  accessTokenEnc    String              // AES-256-GCM encrypted
  tokenIv           String              // encryption IV (hex)
  tokenTag          String              // GCM auth tag (hex)
  scopes            String[]
  status            GitHubAccountStatus @default(ACTIVE)
  connectedAt       DateTime            @default(now())
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  repositoryIntegrations RepositoryIntegration[]

  @@index([userId])
  @@index([institutionId])
  @@index([githubLogin])
  @@index([status])
}

// Association between PRISM project/team and a GitHub repository
model RepositoryIntegration {
  id                String     @id @default(cuid())
  institutionId     String
  projectId         String?
  teamId            String?
  githubAccountId   String     // which PRISM user's GitHub account
  githubRepoId      String     // numeric GitHub repo ID
  owner             String     // "org" or "username"
  repoName          String     // "my-project"
  fullName          String     // "owner/repo"
  htmlUrl           String
  cloneUrl          String?
  defaultBranch     String     @default("main")
  isPrivate         Boolean    @default(true)
  primaryLanguage   String?
  languages         Json       @default("{}")   // { "TypeScript": 12345, ... }
  description       String?
  topics            String[]
  stargazersCount   Int        @default(0)
  forksCount        Int        @default(0)
  openIssuesCount   Int        @default(0)
  size              Int        @default(0)      // KB
  webhookId         String?
  webhookActive     Boolean    @default(false)
  webhookSecret     String?    // random secret for HMAC
  lastSyncedAt      DateTime?
  lastSyncStatus    SyncStatus @default(PENDING)
  lastSyncError     String?
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team         Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  githubAccount GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Restrict)

  syncHistory    RepositorySync[]
  analysisRuns   AnalysisRun[]
  prIntegrations PullRequestIntegration[]
  contributors   RepositoryContributor[]

  @@unique([projectId, githubRepoId])
  @@index([institutionId])
  @@index([projectId])
  @@index([teamId])
  @@index([fullName])
  @@index([githubAccountId])
}

// Contributor stats per repository integration
model RepositoryContributor {
  id                     String   @id @default(cuid())
  repositoryIntegrationId String
  githubLogin            String
  githubUserId           String?
  userId                 String?  // matched PRISM user
  commitCount            Int      @default(0)
  additions              Int      @default(0)
  deletions              Int      @default(0)
  prCount                Int      @default(0)
  mergedPrCount          Int      @default(0)
  reviewCount            Int      @default(0)
  avatarUrl              String?
  profileUrl             String?
  lastActivityAt         DateTime?
  contributionPct        Float    @default(0) // % of total commits
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  repositoryIntegration RepositoryIntegration @relation(fields: [repositoryIntegrationId], references: [id], onDelete: Cascade)
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([repositoryIntegrationId, githubLogin])
  @@index([repositoryIntegrationId])
  @@index([userId])
}

// Sync history for a repository integration
model RepositorySync {
  id                     String     @id @default(cuid())
  repositoryIntegrationId String
  status                 SyncStatus @default(PENDING)
  triggeredBy            String     @default("manual") // "webhook" | "manual" | "scheduled"
  commitsFetched         Int        @default(0)
  prsFetched             Int        @default(0)
  contributorsFetched    Int        @default(0)
  errorMessage           String?
  durationMs             Int?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  repositoryIntegration RepositoryIntegration @relation(fields: [repositoryIntegrationId], references: [id], onDelete: Cascade)

  @@index([repositoryIntegrationId])
  @@index([status])
  @@index([createdAt])
}

// Extended PR data linked to PRISM repository integration
model PullRequestIntegration {
  id                     String    @id @default(cuid())
  repositoryIntegrationId String
  githubPrId             String    // numeric GitHub PR ID
  githubPrNumber         Int
  title                  String
  body                   String?
  state                  String    // "open" | "closed" | "merged"
  isDraft                Boolean   @default(false)
  authorLogin            String
  authorId               String?
  headSha                String
  baseSha                String?
  mergeCommitSha         String?
  headBranch             String
  baseBranch             String
  additions              Int       @default(0)
  deletions              Int       @default(0)
  changedFiles           Int       @default(0)
  commits                Int       @default(0)
  comments               Int       @default(0)
  reviewComments         Int       @default(0)
  labels                 String[]
  requestedReviewers     String[]
  mergedAt               DateTime?
  closedAt               DateTime?
  htmlUrl                String
  githubCreatedAt        DateTime
  githubUpdatedAt        DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  repositoryIntegration RepositoryIntegration @relation(fields: [repositoryIntegrationId], references: [id], onDelete: Cascade)
  reviews               PullRequestReviewIntegration[]
  analysisRuns          AnalysisRun[]

  @@unique([repositoryIntegrationId, githubPrNumber])
  @@index([repositoryIntegrationId])
  @@index([state])
  @@index([authorLogin])
  @@index([mergedAt])
}

// Individual PR review records
model PullRequestReviewIntegration {
  id                       String    @id @default(cuid())
  pullRequestIntegrationId String
  githubReviewId           String    @unique
  reviewerLogin            String
  reviewerId               String?
  state                    String    // "APPROVED" | "CHANGES_REQUESTED" | "COMMENTED" | "DISMISSED"
  body                     String?
  submittedAt              DateTime
  commitId                 String?
  htmlUrl                  String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  pullRequest PullRequestIntegration @relation(fields: [pullRequestIntegrationId], references: [id], onDelete: Cascade)

  @@index([pullRequestIntegrationId])
  @@index([reviewerLogin])
}

// A single analysis run (triggered by PR merge, webhook, or manually)
model AnalysisRun {
  id                       String            @id @default(cuid())
  institutionId            String
  repositoryIntegrationId  String
  pullRequestIntegrationId String?
  uploadedProjectId        String?           // if from ZIP upload
  evaluationRunId          String?           // linked PRISM evaluation
  commitSha                String?
  headBranch               String?
  triggerType              String            @default("manual") // "webhook" | "manual" | "zip_upload"
  status                   AnalysisRunStatus @default(QUEUED)
  phase                    PhaseNumber       @default(PHASE_1)
  detectedLanguages        String[]
  toolsRun                 String[]
  toolsAvailable           String[]
  errorMessage             String?
  durationMs               Int?
  overallScore             Float?
  dimensionScores          Json              @default("{}") // { code_quality: 72, ... }
  metadata                 Json              @default("{}")
  queuedAt                 DateTime          @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  institution           Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  repositoryIntegration RepositoryIntegration  @relation(fields: [repositoryIntegrationId], references: [id], onDelete: Cascade)
  pullRequest           PullRequestIntegration? @relation(fields: [pullRequestIntegrationId], references: [id], onDelete: SetNull)
  uploadedProject       UploadedProject?       @relation(fields: [uploadedProjectId], references: [id], onDelete: SetNull)
  evaluationRun         EvaluationRun?         @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)

  metricEvidence MetricEvidence[]

  @@index([institutionId])
  @@index([repositoryIntegrationId])
  @@index([status])
  @@index([createdAt])
}

// Per-metric evidence from an analysis run
model MetricEvidence {
  id            String       @id @default(cuid())
  analysisRunId String
  metricId      String       // references MetricDefinition.metricId
  dimension     String       // "code_quality" | "security" | etc.
  toolName      String       // "eslint" | "bandit" | "semgrep" | etc.
  status        MetricStatus @default(PENDING)
  rawValue      Float?
  unit          String?      // "%" | "count" | "score"
  normalizedScore Float?     // 0-100
  weight        Float        @default(1.0)
  findings      Json         @default("[]")  // array of individual tool findings
  evidence      Json         @default("{}")  // raw tool output
  errorMessage  String?
  computedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@index([dimension])
  @@index([metricId])
  @@index([status])
}

// ZIP-uploaded project (alternative to GitHub)
model UploadedProject {
  id              String       @id @default(cuid())
  institutionId   String
  projectId       String?
  teamId          String?
  uploadedById    String
  originalFilename String
  storedFilename  String       // UUID-named stored file
  storedPath      String       // server-side path
  fileSizeBytes   Int
  checksum        String       // SHA-256
  status          UploadStatus @default(UPLOADED)
  detectedLanguages String[]
  fileCount       Int          @default(0)
  projectStructure Json        @default("{}")  // { src: [...], tests: [...], docs: [...] }
  validationErrors String[]
  extractedPath   String?      // temp extraction dir
  metadata        Json         @default("{}")
  confirmedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  analysisRuns AnalysisRun[]

  @@index([institutionId])
  @@index([projectId])
  @@index([teamId])
  @@index([status])
}
