# Application
NODE_ENV=development
PORT=4000
DEMO_MODE=true

# Database
DATABASE_URL="postgresql://prism_user:prism_pass@localhost:5432/prism_db?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GitHub App (optional - uses demo mode if not set)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
